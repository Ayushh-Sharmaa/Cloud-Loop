# =============================================================================
# Cloud Loop — Environment Variables Template
# IBM Db2 TechX Summit 2026 Submission
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. Authentication Mode
# "demo" for instant zero-credential evaluation, or "clerk" for production auth
# -----------------------------------------------------------------------------
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# -----------------------------------------------------------------------------
# 3. IBM Db2 Connection
# Used by Haystack IBMDb2DocumentStore and relational repositories
# -----------------------------------------------------------------------------
DB2_HOST=localhost
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_DB=BLUDB
DB2_DATABASE=BLUDB
DB2_USERNAME=db2inst1
DB2_UID=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_PWD=your_db2_password_here
DB2_SCHEMA=CLOUDLOOP
DB2_SSL=False

# -----------------------------------------------------------------------------
# 4. Haystack & Vector Search Settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
DISTANCE_METRIC=COSINE

# -----------------------------------------------------------------------------
# 5. Administrative Key for Batch Ingestion Pipeline
# -----------------------------------------------------------------------------
ADMIN_API_KEY=your_admin_api_key_here
