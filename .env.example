# =============================================================================
# Cloud Loop — Environment Configuration
# IBM Db2 TechX Summit Hackathon Submission
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Primary Database & Vector Storage)
# Required for Live AI Search, User Opportunities, and Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. IBM Db2 (Optional Enterprise Database & Analytic Layer)
# If configured, opportunities & searches are mirrored to IBM Db2 tables.
# If unconfigured, the application gracefully degrades to Supabase + In-Memory.
# -----------------------------------------------------------------------------
DB2_HOSTNAME=dashdb-txn-sng01.services.dal.bluemix.net
DB2_PORT=50000
DB2_DATABASE=BLUDB
DB2_UID=db2user
DB2_PWD=your-db2-password
DB2_SSL=true
DB2_SSL_DSN=DATABASE=BLUDB;HOSTNAME=dashdb-txn-sng01.services.dal.bluemix.net;PORT=50001;PROTOCOL=TCPIP;UID=db2user;PWD=your-db2-password;Security=SSL;

# -----------------------------------------------------------------------------
# 3. Clerk Authentication (User Sign-in & Dashboard Security)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# -----------------------------------------------------------------------------
# 4. Generative AI & LangChain RAG (Google Gemini / OpenAI)
# Optional: If omitted, deterministic smart vector matching is used.
# -----------------------------------------------------------------------------
GOOGLE_AI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# 5. Application URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

