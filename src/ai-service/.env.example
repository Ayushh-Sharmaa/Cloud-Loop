# Cloud Loop AI Service - Environment Template
# NEVER commit actual secrets or credentials to source control.

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Authentication mode: "demo" (evaluation mode without Clerk) or "clerk"
AUTH_MODE=demo

# IBM Db2 Enterprise / Community Connection
DB2_HOST=db2
DB2_PORT=50000
DB2_DB=BLUDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SCHEMA=CLOUDLOOP
DB2_SSL=False

# Haystack & Embeddings Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
DISTANCE_METRIC=COSINE

# Administrative API Key for Ingestion Pipelines
ADMIN_API_KEY=your_admin_api_key_here
