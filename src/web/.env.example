# =============================================================================
# Cloud Loop — Environment Configuration
# IBM Db2 TechX Summit 2026 Submission
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI Service Backend Connection
# -----------------------------------------------------------------------------
FASTAPI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. Authentication Mode
# "demo" for instant zero-credential evaluation, or "clerk" for production auth
# -----------------------------------------------------------------------------
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# -----------------------------------------------------------------------------
# 3. IBM Db2 Connection (Optional direct connection from Next.js server actions)
# Primary database operations are managed via the ai-service backend
# -----------------------------------------------------------------------------
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_DATABASE=BLUDB
DB2_UID=db2inst1
DB2_PWD=your_db2_password_here
DB2_SSL=false

# -----------------------------------------------------------------------------
# 4. Application URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
