{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "title": "Cloud Loop",
    "slug": "cloud-loop",
    "short_description": "AI-Powered Student Opportunity Intelligence Platform backed by IBM Db2, Haystack vector search, and automated eligibility matching.",
    "category": "AI / RAG / Data Engineering / Analytics",
    "demo_url": "https://cloudloop.dev",
    "video_url": "https://youtu.be/cloudloop-demo-2026",
    "repo_url": "https://github.com/Ayushh-Sharmaa/Cloud-Loop"
  },
  "team": {
    "name": "Cloud Loop Team",
    "members": [
      {
        "name": "Ayush Sharma",
        "github": "Ayushh-Sharmaa",
        "email": "ayushsharma@users.noreply.github.com",
        "role": "Lead Architect / Full-Stack & Db2 AI Engineer"
      }
    ]
  },
  "ibm_db2": {
    "edition": "Db2 Community Edition (Docker) / Db2 on Cloud",
    "connector": "ibm-db-haystack / ibm_db",
    "features_used": [
      "IBMDb2DocumentStore (Haystack Vector Storage)",
      "384-Dimensional Dense Vector Retrieval (COSINE distance)",
      "Relational Schema (OPPORTUNITIES, STUDENT_PROFILES, TRACKED_OPPORTUNITIES, INGESTION_RUNS)",
      "SQL View (V_ACTIVE_OPPORTUNITIES)",
      "Parameterized Prepared Statements & SQL Injection Prevention",
      "Transactional Foreign Keys & Unique Constraints",
      "High-Performance B-Tree Secondary Indexes"
    ]
  },
  "tech_stack": {
    "languages": [
      "TypeScript",
      "Python",
      "SQL"
    ],
    "frameworks": [
      "Next.js 16 (Turbopack, App Router)",
      "React 19",
      "Tailwind CSS v4",
      "FastAPI",
      "Haystack AI (haystack-ai 3.4.1)",
      "ibm-db-haystack (1.0.0)"
    ],
    "ai_models": [
      "sentence-transformers/all-MiniLM-L6-v2"
    ]
  }
}
